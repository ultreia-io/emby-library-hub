<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Description>Library browsing, daily archives and email subscriptions for Emby, in French or English.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.11.0.5-beta6" PrivateAssets="all" Condition="'$(EmbyReferencePath)' == ''" />
    <PackageReference Include="System.Memory" Version="4.6.3" PrivateAssets="all" />
    <Reference Include="$(EmbyReferencePath)/MediaBrowser.*.dll" Condition="'$(EmbyReferencePath)' != ''" Private="false" />
    <Reference Include="$(EmbyReferencePath)/Emby.Naming.dll" Condition="'$(EmbyReferencePath)' != ''" Private="false" />
    <Compile Include="../Emby.LibraryHub.Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docs/assets/logo.svg" LogicalName="Emby.LibraryHub.Standalone.logo.svg" />
    <EmbeddedResource Include="../../docs/assets/logo.png" LogicalName="Emby.LibraryHub.Standalone.logo.png" />
    <EmbeddedResource Include="../../docs/assets/favicon.svg" LogicalName="Emby.LibraryHub.Standalone.favicon.svg" />
    <EmbeddedResource Include="../../docs/assets/favicon.png" LogicalName="Emby.LibraryHub.Standalone.favicon.png" />
    <EmbeddedResource Include="Standalone/page.html" />
    <EmbeddedResource Include="Standalone/app.js" />
    <EmbeddedResource Include="Standalone/browse.js" />
    <EmbeddedResource Include="Configuration/config.html" />
    <EmbeddedResource Include="Configuration/browse.html" />
    <EmbeddedResource Include="Configuration/browse.js" />
    <EmbeddedResource Include="Configuration/config.js" />
    <EmbeddedResource Include="Configuration/locale.js" />
    <EmbeddedResource Include="Configuration/reports.html" />
    <EmbeddedResource Include="Configuration/reports.js" />
    <EmbeddedResource Include="Configuration/subscriptions.html" />
    <EmbeddedResource Include="Configuration/subscriptions.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MailKitLite" Version="4.18.1" GeneratePathProperty="true" />
    <PackageReference Include="MimeKitLite" Version="4.18.1" GeneratePathProperty="true" />
    <EmbeddedResource Include="../../docs/THIRD-PARTY-NOTICES.txt" LogicalName="Emby.LibraryHub.THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="../../LICENSE" LogicalName="Emby.LibraryHub.LICENSE" />
    <EmbeddedResource Include="../../NOTICE" LogicalName="Emby.LibraryHub.NOTICE" />
  </ItemGroup>
  <!-- Include the resolved portable dependency closure; never redistribute Emby's SDK assemblies. -->
  <Target Name="EmbedPortableDependencies" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ReferenceCopyLocalPaths)"
                        Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' != '' And '%(ReferenceCopyLocalPaths.NuGetPackageId)' != 'MediaBrowser.Common' And '%(ReferenceCopyLocalPaths.NuGetPackageId)' != 'MediaBrowser.Server.Core' And '%(ReferenceCopyLocalPaths.Extension)' == '.dll'">
        <LogicalName>Emby.LibraryHub.Dependencies.%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
  <Target Name="StampPageVersions" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <VersionedPage Include="Configuration/*.html;Standalone/page.html" />
      <VersionedPage Update="@(VersionedPage)">
        <LogicalName>Emby.LibraryHub.$([System.String]::Copy('%(VersionedPage.Identity)').Replace('/', '.'))</LogicalName>
        <OutputFile>$(IntermediateOutputPath)versioned/%(VersionedPage.Identity)</OutputFile>
      </VersionedPage>
    </ItemGroup>
    <MakeDir Directories="@(VersionedPage->'$(IntermediateOutputPath)versioned/%(RelativeDir)')" />
    <WriteLinesToFile File="%(VersionedPage.OutputFile)"
                      Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('%(VersionedPage.Identity)').Replace('{{VERSION}}', '$(Version)'))))"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <EmbeddedResource Remove="@(VersionedPage)" />
      <EmbeddedResource Include="@(VersionedPage->'%(OutputFile)')" />
    </ItemGroup>
  </Target>
</Project>
